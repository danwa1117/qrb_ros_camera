<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_backend_qmmf</name>
  <version>1.0.0</version>
  <description>QMMF/CamX camera backend (IQ9) for plugin_discovery (no ROS)</description>
  <maintainer email="danwa@qti.qualcomm.com">Dan Wang</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>cmake</buildtool_depend>
  <depend>plugin_discovery</depend>
  <depend>camera_interface</depend>
  <!-- QMMF/CamX vendor SDK (as in qrb_ros_camera for IQ9) -->
  <depend>libqmmf-dev</depend>
  <depend>camxapi-dev</depend>
  <depend>syslog-plumber-dev</depend>
  <exec_depend>camera-server</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
