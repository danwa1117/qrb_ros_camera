@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(plugin_discovery 0.3)
find_dependency(camera_interface 1.0)

include("${CMAKE_CURRENT_LIST_DIR}/qrb_cameraTargets.cmake")
# For ament_target_dependencies() / ament_auto in ROS packages that depend on this one.
set(qrb_camera_TARGETS qrb_camera::qrb_camera)
check_required_components(qrb_camera)
