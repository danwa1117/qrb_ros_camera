set -e
# platform-detect ran once at the first boot (or when plugin-discovery was installed),
# before these candidates existed: refresh the links it made so the matching one is
# picked up. Links it did not make (edited by hand) are left alone.
if [ "$1" = configure ] && [ -x /usr/bin/platform-detect ]; then
  /usr/bin/platform-detect --force || true
fi
#DEBHELPER#
exit 0
